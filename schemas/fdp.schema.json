{
  "$defs": {
    "AirflowSettings": {
      "additionalProperties": false,
      "description": "How an Airflow deployment runs.",
      "properties": {
        "mode": {
          "default": "standalone",
          "description": "standalone: one container, LocalExecutor with PostgreSQL; SQLite/SequentialExecutor only for local development. distributed: separate webserver, scheduler and Celery workers.",
          "enum": [
            "standalone",
            "distributed"
          ],
          "title": "Mode",
          "type": "string"
        },
        "local_parallelism": {
          "default": 2,
          "description": "Concurrent orchestration tasks in a single-container PostgreSQL deployment.",
          "maximum": 32,
          "minimum": 1,
          "title": "Local Parallelism",
          "type": "integer"
        },
        "workers": {
          "default": 2,
          "description": "Celery workers (distributed).",
          "maximum": 32,
          "minimum": 1,
          "title": "Workers",
          "type": "integer"
        },
        "worker_concurrency": {
          "default": 8,
          "description": "Tasks per worker at a time (distributed).",
          "maximum": 64,
          "minimum": 1,
          "title": "Worker Concurrency",
          "type": "integer"
        },
        "worker_warehouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Warehouse for workers (default: the program's).",
          "title": "Worker Warehouse"
        },
        "parallelism": {
          "default": 32,
          "description": "Max running tasks across the deployment.",
          "maximum": 512,
          "minimum": 1,
          "title": "Parallelism",
          "type": "integer"
        }
      },
      "title": "AirflowSettings",
      "type": "object"
    },
    "Arg": {
      "additionalProperties": false,
      "description": "One input of a program. The UI renders a matching form field.",
      "properties": {
        "name": {
          "description": "Identifier; also the key in fdp.args().",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "string",
          "description": "Form field type. data_source = pick one of your granted sources.",
          "enum": [
            "string",
            "text",
            "integer",
            "number",
            "boolean",
            "choice",
            "date",
            "data_source"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Label shown in the form (defaults to the name).",
          "title": "Label"
        },
        "help": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hint shown under the field.",
          "title": "Help"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Options for type=choice.",
          "title": "Choices"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum for integer/number.",
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum for integer/number.",
          "title": "Max"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regular expression a string must match.",
          "title": "Pattern"
        },
        "flag": {
          "anyOf": [
            {
              "pattern": "^--?[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Command-line flag, default --<name> with _ replaced by -. Booleans are passed as a bare flag when true.",
          "title": "Flag"
        },
        "positional": {
          "default": false,
          "description": "Pass the value as a positional argument instead of a flag.",
          "title": "Positional",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "Arg",
      "type": "object"
    },
    "DbtSettings": {
      "additionalProperties": false,
      "description": "Where a dbt project reads and writes. Credentials come from the data source (OpenBao).",
      "properties": {
        "data_source": {
          "description": "Data source to build in (needs write access, e.g. finance-dw-transform).",
          "title": "Data Source",
          "type": "string"
        },
        "schema": {
          "default": "analytics",
          "description": "Production schema (deployed runs).",
          "title": "Schema",
          "type": "string"
        },
        "dev_schema": {
          "default": "dbt_{user}",
          "description": "Schema for workspace runs; {user} is your user name.",
          "title": "Dev Schema",
          "type": "string"
        },
        "threads": {
          "default": 4,
          "maximum": 64,
          "minimum": 1,
          "title": "Threads",
          "type": "integer"
        }
      },
      "required": [
        "data_source"
      ],
      "title": "DbtSettings",
      "type": "object"
    },
    "LineageReference": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "schema": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "schema",
        "name"
      ],
      "title": "LineageReference",
      "type": "object"
    },
    "Program": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "layer": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Layer name or stable ID. Only available in a matching workspace/workload layer; never grants access. Inherits the file's layer when omitted.",
          "title": "Layer"
        },
        "lineage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgramLineage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional manual dependencies for access outside Floren Data Platform. SQL, managed API calls, SDK files, dbt and Airflow capture lineage automatically. Does not grant data access."
        },
        "kind": {
          "default": "script",
          "description": "script = run to completion; notebook = execute with papermill; app = Streamlit/Shiny server; dbt = a dbt project (entrypoint = folder with dbt_project.yml); airflow = an Airflow deployment (entrypoint = folder with dags/); stream = a continuous Python/R consumer with managed identity and readiness.",
          "enum": [
            "script",
            "notebook",
            "app",
            "dbt",
            "airflow",
            "stream"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entrypoint": {
          "description": "File or folder, relative to the fdp.json folder.",
          "title": "Entrypoint",
          "type": "string"
        },
        "runtime": {
          "anyOf": [
            {
              "enum": [
                "python",
                "r"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inferred from the entrypoint when omitted.",
          "title": "Runtime"
        },
        "python": {
          "anyOf": [
            {
              "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python version from the runtime catalog, e.g. 3.12.",
          "title": "Python"
        },
        "r": {
          "anyOf": [
            {
              "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "R version from the runtime catalog, e.g. 4.4.",
          "title": "R"
        },
        "dbt_version": {
          "anyOf": [
            {
              "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dbt version from the runtime catalog, e.g. 1.8.",
          "title": "Dbt Version"
        },
        "airflow": {
          "anyOf": [
            {
              "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Airflow version from the runtime catalog, e.g. 2.10.",
          "title": "Airflow"
        },
        "dbt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DbtSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for kind dbt."
        },
        "airflow_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/AirflowSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For kind airflow."
        },
        "requirements": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Python: a requirements.txt. R: a text file with one package per line, or an renv.lock. Installed once into a cached environment and reused until the file changes.",
          "title": "Requirements"
        },
        "warehouse": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default warehouse (compute pool) for this program.",
          "title": "Warehouse"
        },
        "data_sources": {
          "description": "Data sources the program needs; checked before it starts.",
          "items": {
            "type": "string"
          },
          "title": "Data Sources",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables (no secret values here).",
          "title": "Env",
          "type": "object"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables filled from Floren Data Platform secrets: {\"API_KEY\": \"<ref>\"}, where <ref> is me/<name> (yours or the service account running it), group:<group>/<name> or sa:<account>/<name>.",
          "title": "Secrets",
          "type": "object"
        },
        "args": {
          "items": {
            "$ref": "#/$defs/Arg"
          },
          "title": "Args",
          "type": "array"
        }
      },
      "required": [
        "entrypoint"
      ],
      "title": "Program",
      "type": "object"
    },
    "ProgramLineage": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "maxItems": 500,
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/LineageReference"
          },
          "maxItems": 500,
          "title": "Outputs",
          "type": "array"
        }
      },
      "title": "ProgramLineage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "fdp.json \u2014 programs this workspace can run on a warehouse.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "$Schema"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "warehouse": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default warehouse for programs that don't set one.",
      "title": "Warehouse"
    },
    "layer": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default layer name or stable ID for programs in this file. Programs can override it. Omitted means use the workspace/workload layer.",
      "title": "Layer"
    },
    "python": {
      "anyOf": [
        {
          "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default Python version.",
      "title": "Python"
    },
    "r": {
      "anyOf": [
        {
          "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default R version.",
      "title": "R"
    },
    "dbt_version": {
      "anyOf": [
        {
          "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default dbt version.",
      "title": "Dbt Version"
    },
    "airflow": {
      "anyOf": [
        {
          "pattern": "^[0-9][0-9A-Za-z.\\-]{0,15}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default Airflow version.",
      "title": "Airflow"
    },
    "programs": {
      "additionalProperties": {
        "$ref": "#/$defs/Program"
      },
      "description": "Keyed by program name (lowercase, dashes).",
      "title": "Programs",
      "type": "object"
    }
  },
  "title": "Floren Data Platform workspace config",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fdp.schema.json"
}
