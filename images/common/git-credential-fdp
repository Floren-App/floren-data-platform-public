#!/bin/sh
# git credential helper: asks Floren Data Platform for your own token for the host git talks to (saved in the
# app under Account → Git credentials). Nothing is stored in the workspace; "store" and "erase" do nothing.
[ "${1:-}" = get ] || { cat >/dev/null; exit 0; }
protocol= host=
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in protocol) protocol=$value ;; host) host=$value ;; esac
done
[ -n "$host" ] && [ -n "${FDP_API:-}" ] && [ -n "${FDP_SESSION_TOKEN:-}" ] && [ -n "${FDP_WORKSPACE_ID:-}" ] || exit 0
reply=$(curl -sS --noproxy '*' -m 10 -w '\n%{http_code}' -H "Authorization: Bearer $FDP_SESSION_TOKEN" -G \
  --data-urlencode "host=$host" --data-urlencode "protocol=$protocol" \
  "$FDP_API/v1/workspaces/$FDP_WORKSPACE_ID/git-credential" 2>/dev/null) || exit 0
status=${reply##*
}
if [ "$status" = 200 ]; then
  printf '%s\n' "${reply%
*}"
elif [ "$status" = 404 ] && [ "$protocol" = https ]; then
  reason=$(printf '%s' "${reply%
*}" | sed -n 's/.*"detail":"\([^"]*\)".*/\1/p')
  echo "fdp: ${reason:-no Git credential for $host; add one in the app under Account → Git credentials}" >&2
fi
exit 0
