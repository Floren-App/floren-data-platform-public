{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dataVolume": {
      "type": "object", "additionalProperties": false,
      "required": ["size", "nfs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "nfs": {
          "type": "object", "additionalProperties": false,
          "required": ["server", "path"],
          "properties": {
            "server": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[^\\s/]+$"},
            "path": {"type": "string", "minLength": 1, "pattern": "^/[^\\r\\n]*$"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "namespace": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "layerController": {
      "type":"object", "additionalProperties":false,
      "properties": {
        "enabled":{"type":"boolean"},
        "network":{
          "type":"object", "additionalProperties":false,
          "properties":{
            "podCidrs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":3}},
            "serviceCidrs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":3}},
            "nodeCidrs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":3}},
            "cilium":{"enum":["auto",true,false,"true","false"]},
            "kafkaApiServerCidrs":{"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^.+/(32|128)$"}},
            "protectedCidrs":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string","minLength":3}}
          }
        },
        "dnsNamespace":{"type":"string", "maxLength":63, "pattern":"^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "resources":{"type":"object"}
      }
    },
    "oidc": {
      "type":"object", "additionalProperties":false,
      "properties":{
        "issuer":{"type":"string","minLength":1},
        "audience":{"type":"string","minLength":1},
        "clientId":{"type":"string","minLength":1},
        "jwksUrl":{"type":"string"},
        "rolesClaim":{"type":"string","minLength":1},
        "groupsClaim":{"type":"string","minLength":1},
        "usernameClaim":{"type":"string","minLength":1},
        "adminRole":{"type":"string","minLength":1},
        "directoryMode":{"type":"string","enum":["scim","oidc"]}
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["disabled", "existing", "certManager"]},
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "kind": {"type": "string", "enum": ["Issuer", "ClusterIssuer"]}
          }
        },
        "additionalDnsNames": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "duration": {"type": "string", "pattern": "^[1-9][0-9]*h$"},
        "renewBefore": {"type": "string", "pattern": "^[1-9][0-9]*h$"}
      }
    },
    "certificateMonitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"intervalSeconds": {"type": "integer", "minimum": 30, "maximum": 86400}}
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"caBundleSecret": {"type": "string"}}
    },
    "metadataDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {"type":"string","maxLength":63,"pattern":"^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "airflow": {"type":"object","additionalProperties":false,"required":["enabled"],"properties":{"enabled":{"type":"boolean"}}},
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string"},
        "connectionSecret": {"type": "string"},
        "storageClass": {"type": "string"},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "resources": {"type": "object"}
      }
    },
    "bootstrap": {
      "type":"object", "additionalProperties":false,
      "properties":{"enabled":{"type":"boolean"}}
    },
    "secretManagement": {
      "type":"object", "additionalProperties":false,
      "properties":{
        "backend":{"type":"string","enum":["openbao","vault","kubernetes","aws","azure","gcp"]},
        "namespace":{"type":"string","maxLength":63,"pattern":"^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "aws":{"type":"object","additionalProperties":false,"properties":{
          "region":{"type":"string"},"prefix":{"type":"string","maxLength":100},"kmsKeyId":{"type":"string"},
          "recoveryWindowDays":{"type":"integer","anyOf":[{"const":0},{"minimum":7,"maximum":30}]}}},
        "azure":{"type":"object","additionalProperties":false,"properties":{
          "vaultUrl":{"type":"string","pattern":"^$|^https://[^/?#]+/?$"},
          "prefix":{"type":"string","maxLength":40,"pattern":"^[A-Za-z0-9-]*$"}}},
        "gcp":{"type":"object","additionalProperties":false,"properties":{
          "project":{"type":"string"},"prefix":{"type":"string","maxLength":100,"pattern":"^[A-Za-z0-9_-]*$"},
          "locations":{"type":"array","items":{"type":"string","minLength":1}}}}
      }
    },
    "siem": {
      "type":"object", "additionalProperties":false,
      "properties":{
        "stdout":{"type":"boolean"},
        "syslog":{"type":"object","additionalProperties":false,"properties":{
          "address":{"type":"string","pattern":"^$|^(\\[[0-9a-fA-F:]+\\]|[A-Za-z0-9.-]+):[0-9]{1,5}$"},
          "transport":{"type":"string","enum":["tls","tcp","udp"]},
          "facility":{"type":"integer","minimum":0,"maximum":23},
          "clientCertSecret":{"type":"string"}}},
        "http":{"type":"object","additionalProperties":false,"properties":{
          "url":{"type":"string","pattern":"^$|^https?://"},
          "format":{"type":"string","enum":["generic","splunk","elastic"]},
          "index":{"type":"string","minLength":1}}},
        "otlp":{"type":"object","additionalProperties":false,"properties":{
          "endpoint":{"type":"string","pattern":"^$|^https?://"}}},
        "includeQueries":{"type":"boolean"},
        "includeSqlText":{"type":"boolean"},
        "start":{"type":"string","enum":["beginning","now"]}
      }
    },
    "serviceAccount": {
      "type":"object", "additionalProperties":false,
      "properties":{"annotations":{"type":"object","additionalProperties":{"type":"string"}}}
    },
    "podLabels": {"type":"object","additionalProperties":{"type":"string"}},
    "openbao": {
      "type":"object", "additionalProperties":false,
      "properties":{
        "addr":{"type":"string","pattern":"^https?://[^/?#]+/?$"},
        "kvMount":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_-]+$"},
        "enterpriseNamespace":{"type":"string"},
        "auth":{"type":"object","additionalProperties":false,"properties":{
          "method":{"type":"string","enum":["token","kubernetes","approle"]},
          "role":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_.-]+$"},
          "mount":{"type":"string","pattern":"^[A-Za-z0-9_/-]*$"}}},
        "enabled":{"type":"boolean"},
        "image":{"type":"string","minLength":1},
        "namespace":{"type":"string","maxLength":63,"pattern":"^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "replicas":{"type":"integer","enum":[1,3,5]},
        "storageClass":{"type":"string"},
        "size":{"type":"string","pattern":"^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "seal":{"type":"object","additionalProperties":false,"properties":{
          "mode":{"type":"string","enum":["kubernetes","kms"]},
          "existingSecret":{"type":"string"},
          "keyId":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_.-]+$"},
          "kms":{"type":"object","additionalProperties":false,"properties":{
            "type":{"type":"string","enum":["awskms","azurekeyvault","gcpckms","transit","ocikms","pkcs11","kmip"]},
            "config":{"type":"object","additionalProperties":{"type":["string","number","boolean"]}}}}}},
        "serviceAccount":{"type":"object","additionalProperties":false,"properties":{
          "annotations":{"type":"object","additionalProperties":{"type":"string"}}}},
        "podLabels":{"type":"object","additionalProperties":{"type":"string"}},
        "extraEnv":{"type":"array","items":{"type":"object"}},
        "selfInitialize":{"type":"boolean"},
        "tls":{"type":"object","additionalProperties":false,"properties":{
          "mode":{"type":"string","enum":["disabled","existing","certManager"]},
          "secretName":{"type":"string","minLength":1},
          "issuerRef":{"type":"object","additionalProperties":false,"properties":{
            "name":{"type":"string"},"kind":{"type":"string","enum":["Issuer","ClusterIssuer"]}}}}},
        "networkPolicy":{"type":"object","additionalProperties":false,"properties":{
          "apiServerCidrs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "cilium":{"enum":["auto",true,false]}}},
        "resources":{"type":"object"}
      }
    },
    "keycloak": {
      "type":"object", "additionalProperties":false,
      "properties":{
        "enabled":{"type":"boolean"},
        "image":{"type":"string","minLength":1},
        "publicUrl":{"type":"string","pattern":"^https://[^/?#]+/?$"},
        "realm":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-zA-Z0-9_-]+$"},
        "existingSecret":{"type":"string"},
        "initialAdminUser":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.@-]*$"},
        "passwordGrantEnabled":{"type":"boolean"},
        "desktopRedirectUris":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
        "database":{"type":"object","additionalProperties":false,"properties":{"existingSecret":{"type":"string"}}},
        "automationClient":{"type":"object","additionalProperties":false,"properties":{"enabled":{"type":"boolean"}}},
        "directorySync":{"type":"object","additionalProperties":false,"properties":{
          "enabled":{"type":"boolean"},"intervalSeconds":{"type":"integer","minimum":5,"maximum":3600}}},
        "resources":{"type":"object"}
      }
    }
  }
}
